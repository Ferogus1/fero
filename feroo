-- 13. MAIN LOOP (Evade, Dynamic TP Behind & Wall Stealth)
-- ======================================================
RunService.Heartbeat:Connect(function()
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            
            -- Whitelist Kontrolü
            if not whitelist[player.UserId] then
                local otherHrp = player.Character:FindFirstChild("HumanoidRootPart")
                local otherHum = player.Character:FindFirstChildOfClass("Humanoid")

                if otherHrp and otherHum and otherHum.Health > 0 then
                    local distance = (hrp.Position - otherHrp.Position).Magnitude

                    -- ----------------------------------------------------
                    -- A) AUTO HIDE BEHIND WALL
                    -- ----------------------------------------------------
                    if autoHideEnabled and not hideCooldown and distance <= 25 then
                        if hasLineOfSight(player.Character, hrp.Position) then
                            local coverSpot = findCoverBehindWall(hrp, otherHrp)
                            if coverSpot then
                                hideCooldown = true
                                clearPhysics(char)
                                hrp.CFrame = CFrame.new(coverSpot)
                                playTeleportFX(coverSpot)
                                clearPhysics(char)

                                task.wait(autoHideCooldownTime)
                                hideCooldown = false
                                break
                            end
                        end
                    end

                    -- ----------------------------------------------------
                    -- B) AUTO EVADE & DYNAMIC RANGE TP BEHIND
                    -- ----------------------------------------------------
                    if autoEvadeEnabled and not cooldown then
                        if distance <= detectionDistance and isPlayerInDetectionZone(hrp, otherHrp) then
                            teleportCount = teleportCount + 1

                            if teleportCount % 15 == 0 then
                                cooldown = true
                                task.wait(baseCooldown * 2)
                                cooldown = false
                                break
                            end

                            cooldown = true
                            local finalPosition

                            if tpBehindAttacker then
                                finalPosition = (otherHrp.CFrame * CFrame.new(0, 0, detectionDistance)).Position
                            else
                                local incomingVector = (hrp.Position - otherHrp.Position)
                                local evadeDir = incomingVector.Magnitude > 0 and incomingVector.Unit or -otherHrp.CFrame.LookVector
                                finalPosition = hrp.Position + (evadeDir * detectionDistance)
                            end

                            clearPhysics(char)
                            hrp.CFrame = CFrame.lookAt(finalPosition, otherHrp.Position)
                            playTeleportFX(finalPosition)
                            clearPhysics(char)

                            task.wait(baseCooldown)
                            cooldown = false
                            break
                        end
                    end

                end
            end

        end
    end
end)
