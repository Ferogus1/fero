-- Haritadaki Tüm Oyuncu Karakterlerini Listele (Duvar Olarak Algılanmamaları İçin)
local function getAllPlayerCharacters()
    local chars = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            table.insert(chars, p.Character)
        end
    end
    return chars
end

-- Yön Açı Filtresi (Dot Product)
local function isPlayerInDetectionZone(myHrp, otherHrp)
    if detectionAngleMode == "All 360°" then return true end

    local relPos = (otherHrp.Position - myHrp.Position)
    local flatRelPos = Vector3.new(relPos.X, 0, relPos.Z)
    if flatRelPos.Magnitude == 0 then return true end
    local dirToOther = flatRelPos.Unit

    local lookVec = Vector3.new(myHrp.CFrame.LookVector.X, 0, myHrp.CFrame.LookVector.Z).Unit
    local rightVec = Vector3.new(myHrp.CFrame.RightVector.X, 0, myHrp.CFrame.RightVector.Z).Unit

    local forwardDot = lookVec:Dot(dirToOther)
    local rightDot = math.abs(rightVec:Dot(dirToOther))

    if detectionAngleMode == "Behind Only" then
        return forwardDot < -0.3
    elseif detectionAngleMode == "Sides Only" then
        return rightDot > 0.6
    elseif detectionAngleMode == "Behind & Sides" then
        return forwardDot < 0.3
    elseif detectionAngleMode == "Front Only" then
        return forwardDot > 0.4
    end
    return true
end

-- Görüş Açısı Kontrolü (Oyuncuları duvar saymaz)
local function hasLineOfSight(observerChar, targetPos)
    local observerHrp = observerChar:FindFirstChild("HumanoidRootPart") or observerChar:FindFirstChild("Head")
    if not observerHrp then return false end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = getAllPlayerCharacters()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

    local direction = targetPos - observerHrp.Position
    local result = Workspace:Raycast(observerHrp.Position, direction, raycastParams)

    return result == nil
end

-- Duvar Arkası Güvenli Nokta Bulucu (Oyuncuları duvar saymaz)
local function findCoverBehindWall(myHrp, enemyHrp)
    local offsets = {
        Vector3.new(8, 0, 0), Vector3.new(-8, 0, 0),
        Vector3.new(0, 0, 8), Vector3.new(0, 0, -8),
        Vector3.new(6, 0, 6), Vector3.new(-6, 0, 6),
        Vector3.new(6, 0, -6), Vector3.new(-6, 0, -6)
    }

    local ignoreList = getAllPlayerCharacters()

    for _, offset in ipairs(offsets) do
        local testPos = myHrp.Position + offset

        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = ignoreList
        rayParams.FilterType = Enum.RaycastFilterType.Exclude

        local result = Workspace:Raycast(enemyHrp.Position, (testPos - enemyHrp.Position), rayParams)
        if result then
            local selfParams = RaycastParams.new()
            selfParams.FilterDescendantsInstances = ignoreList
            selfParams.FilterType = Enum.RaycastFilterType.Exclude
            
            local selfResult = Workspace:Raycast(myHrp.Position, offset, selfParams)
            if not selfResult then
                return testPos
            end
        end
    end
    return nil
end

local function clearPhysics(character)
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

