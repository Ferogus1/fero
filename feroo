loadBtn.Parent = configTab
Instance.new("UICorner", loadBtn).CornerRadius = UDim.new(0, 8)

saveBtn.MouseButton1Click:Connect(function()
    if writefile then
        local cfg = {
            detectionDistance = detectionDistance,
            soundEnabled = soundEnabled,
            particlesEnabled = particlesEnabled,
            detectionAngleMode = detectionAngleMode,
            espEnabled = espEnabled
        }
        pcall(function()
            writefile("SoulmatesHub_Config.json", HttpService:JSONEncode(cfg))
            saveBtn.Text = "✅ Saved!"
            task.wait(1.5)
            saveBtn.Text = "💾 Save Configuration"
        end)
    end
end)

loadBtn.MouseButton1Click:Connect(function()
    if readfile and isfile and isfile("SoulmatesHub_Config.json") then
        pcall(function()
            local cfg = HttpService:JSONDecode(readfile("SoulmatesHub_Config.json"))
            if cfg then
                detectionDistance = cfg.detectionDistance or 5
                soundEnabled = cfg.soundEnabled
                particlesEnabled = cfg.particlesEnabled
                detectionAngleMode = cfg.detectionAngleMode or "Behind & Sides"
                espEnabled = cfg.espEnabled

                distLabel.Text = "Range: " .. detectionDistance .. " Studs"
                ringAdornment.Radius = detectionDistance
                zoneBtn.Text = "Detect Zone: " .. detectionAngleMode
                soundBtn.Text = soundEnabled and "Teleport Sound: ON" or "Teleport Sound: OFF"
                particleBtn.Text = particlesEnabled and "Smoke Particles: ON" or "Smoke Particles: OFF"
                espBtn.Text = espEnabled and "Player ESP: ON" or "Player ESP: OFF"
                updateESP()

                loadBtn.Text = "✅ Loaded!"
                task.wait(1.5)
                loadBtn.Text = "📂 Load Configuration"
            end
        end)
    end
end)

-- ----------------------------------------------------
-- 11. Main Loop (Filtered Angle Evade)
-- ----------------------------------------------------
RunService.Heartbeat:Connect(function()
    if not enabled or cooldown then return end

    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local otherHrp = player.Character:FindFirstChild("HumanoidRootPart")
            local otherHum = player.Character:FindFirstChildOfClass("Humanoid")

            if otherHrp and otherHum and otherHum.Health > 0 then
                local distance = (hrp.Position - otherHrp.Position).Magnitude

                -- Hem mesafe hem de açı/yön filtresi kontrol ediliyor
                if distance <= detectionDistance and isPlayerInDetectionZone(hrp, otherHrp) then
                    teleportCount = teleportCount + 1

                    if teleportCount % 15 == 0 then
                        cooldown = true
                        task.wait(baseCooldown)
                        cooldown = false
                        break
                    end

                    cooldown = true
                    local oldPosition = hrp.Position

                    -- Yaklaşan yönün zıttına kaçış vektörü
                    local incomingVector = (hrp.Position - otherHrp.Position)
                    local evadeDir = incomingVector.Magnitude > 0 and incomingVector.Unit or -otherHrp.CFrame.LookVector

                    local rawTargetPos = hrp.Position + (evadeDir * detectionDistance)
                    local ignoreList = {char, player.Character}
                    local finalPosition = getSafePosition(oldPosition, rawTargetPos, ignoreList)

                    clearPhysics(char)

                    local lookTarget = Vector3.new(oldPosition.X, finalPosition.Y, oldPosition.Z)
                    if (finalPosition - lookTarget).Magnitude > 0.1 then
                        hrp.CFrame = CFrame.lookAt(finalPosition, lookTarget)
                    else
                        hrp.CFrame = CFrame.new(finalPosition)
                    end

                    playTeleportFX(finalPosition)
                    clearPhysics(char)

                    task.wait(baseCooldown)
                    cooldown = false
                    break
                end
            end
        end
    end
end)
