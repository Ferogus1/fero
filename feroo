-- ----------------------------------------------------
-- 3. Yardımcı Fizik ve Raycast Fonksiyonları
-- ----------------------------------------------------
local function clearPhysics(character)
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

local function getSafePosition(startPos, targetPos, ignoreList)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = ignoreList
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true

    local direction = targetPos - startPos
    local rayResult = Workspace:Raycast(startPos, direction, raycastParams)

    if rayResult then
        return rayResult.Position - (direction.Unit * 1.5)
    end

    return targetPos
end

-- ----------------------------------------------------
-- 4. 10 Stud Işınlanma Mantığı
-- ----------------------------------------------------
dashBtn.MouseButton1Click:Connect(function()
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local startPos = hrp.Position
    local forwardDir = hrp.CFrame.LookVector
    local desiredTarget = startPos + (forwardDir * DASH_DISTANCE)

    local safePos = getSafePosition(startPos, desiredTarget, {char})

    clearPhysics(char)
    hrp.CFrame = CFrame.new(safePos, safePos + forwardDir)
    clearPhysics(char)
end)

-- ----------------------------------------------------
-- 5. Ana Döngü (Oto Kaçış Mantığı)
-- ----------------------------------------------------
RunService.Heartbeat:Connect(function()
    if not enabled or cooldown then return end

    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local otherHrp = player.Character:FindFirstChild("HumanoidRootPart")
            if otherHrp then
                local distance = (hrp.Position - otherHrp.Position).Magnitude

                if distance <= DETECTION_DISTANCE then
                    teleportCount = teleportCount + 1
                    
                    -- Her 15. ışınlanmayı atla
                    if teleportCount % 15 == 0 then
                        cooldown = true
                        task.wait(COOLDOWN_TIME)
                        cooldown = false
                        break
                    end

                    cooldown = true

                    local oldPosition = hrp.Position

                    local lookDir = otherHrp.CFrame.LookVector
                    local flatLook = Vector3.new(lookDir.X, 0, lookDir.Z)
                    if flatLook.Magnitude > 0 then
                        flatLook = flatLook.Unit
                    else
                        flatLook = Vector3.new(0, 0, -1)
                    end

                    local desiredPosition = Vector3.new(
                        otherHrp.Position.X - (flatLook.X * TELEPORT_DISTANCE),
                        otherHrp.Position.Y,
                        otherHrp.Position.Z - (flatLook.Z * TELEPORT_DISTANCE)
                    )

                    local ignoreList = {char, player.Character}
                    local finalPosition = getSafePosition(oldPosition, desiredPosition, ignoreList)

                    clearPhysics(char)

                    local lookTarget = Vector3.new(oldPosition.X, finalPosition.Y, oldPosition.Z)

                    if (finalPosition - lookTarget).Magnitude > 0.1 then
                        hrp.CFrame = CFrame.lookAt(finalPosition, lookTarget)
                    else
                        hrp.CFrame = CFrame.new(finalPosition)
                    end

                    clearPhysics(char)

                    task.wait(COOLDOWN_TIME)
                    cooldown = false
                    break
                end
            end
        end
    end
end)
