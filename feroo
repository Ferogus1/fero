local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local enabled = false
local cooldown = false
local teleportCount = 0 -- Işınlanma sayacımız

-- Ayarlar
local DETECTION_DISTANCE = 5        -- Algılama mesafesi (5 stud)
local TELEPORT_DISTANCE = 5         -- Hedef ışınlanma mesafesi (5 stud)
local COOLDOWN_TIME = 0.04          -- Bekleme süresi

-- 1. Arayüzü (GUI) Oluşturma
local guiParent = CoreGui
if not pcall(function() return CoreGui:GetChildren() end) then
    guiParent = localPlayer:WaitForChild("PlayerGui")
end

if guiParent:FindFirstChild("DeltaMobileGui") then
    guiParent.DeltaMobileGui:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "DeltaMobileGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = guiParent

local textButton = Instance.new("TextButton")
textButton.Name = "ToggleButton"
textButton.Size = UDim2.new(0, 130, 0, 50)
textButton.Position = UDim2.new(0.75, 0, 0.15, 0)
textButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
textButton.TextColor3 = Color3.fromRGB(255, 255, 255)
textButton.TextSize = 16
textButton.Font = Enum.Font.SourceSansBold
textButton.Text = "Running: OFF"
textButton.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 12)
uiCorner.Parent = textButton

-- Buton Mantığı (Running ON / OFF)
textButton.MouseButton1Click:Connect(function()
    enabled = not enabled
    if enabled then
        textButton.Text = "Running: ON"
        textButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    else
        textButton.Text = "Running: OFF"
        textButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
        teleportCount = 0 -- Kapatıldığında sayacı sıfırla
    end
end)

-- Güvenli Konum Hesaplama (Raycast İle Engel Kontrolü)
local function getSafePosition(startPos, targetPos, ignoreList)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = ignoreList
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true

    local direction = targetPos - startPos
    local rayResult = Workspace:Raycast(startPos, direction, raycastParams)

    if rayResult then
        return rayResult.Position - (direction.Unit * 1.5)
    end

    return targetPos
end

-- Tüm Parçalardaki Fiziksel Momentumu Sıfırlama
local function clearPhysics(character)
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

-- 2. Ana Döngü
RunService.Heartbeat:Connect(function()
    if not enabled or cooldown then return end

    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local otherHrp = player.Character:FindFirstChild("HumanoidRootPart")
            if otherHrp then
                local distance = (hrp.Position - otherHrp.Position).Magnitude

                if distance <= DETECTION_DISTANCE then
                    teleportCount = teleportCount + 1
                    
                    -- Her 15. ışınlanmada işlemi iptal et ama cooldown uygula ki ard arda spam yapmasın
                    if teleportCount % 15 == 0 then
                        cooldown = true
                        task.wait(COOLDOWN_TIME)
                        cooldown = false
                        break
                    end

                    cooldown = true

                    local oldPosition = hrp.Position

                    -- Bakış yönünü yatay eksende sıfırla
                    local lookDir = otherHrp.CFrame.LookVector
                    local flatLook = Vector3.new(lookDir.X, 0, lookDir.Z)
                    if flatLook.Magnitude > 0 then
                        flatLook = flatLook.Unit
                    else
                        flatLook = Vector3.new(0, 0, -1)
                    end

                    -- Hedef noktayı hesapla
                    local desiredPosition = Vector3.new(
                        otherHrp.Position.X - (flatLook.X * TELEPORT_DISTANCE),
                        otherHrp.Position.Y,
                        otherHrp.Position.Z - (flatLook.Z * TELEPORT_DISTANCE)
                    )

                    local ignoreList = {char, player.Character}
                    local finalPosition = getSafePosition(oldPosition, desiredPosition, ignoreList)

                    -- Fizik temizliği
                    clearPhysics(char)

                    -- Karakterin eğilmesini önleyen bakış kilitli ışınlanma
                    local lookTarget = Vector3.new(oldPosition.X, finalPosition.Y, oldPosition.Z)

                    if (finalPosition - lookTarget).Magnitude > 0.1 then
                        hrp.CFrame = CFrame.lookAt(finalPosition, lookTarget)
                    else
                        hrp.CFrame = CFrame.new(finalPosition)
                    end

                    clearPhysics(char)

                    task.wait(COOLDOWN_TIME)
                    cooldown = false
                    break
                end
            end
        end
    end
end)
