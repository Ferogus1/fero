local function createTab(tabName, iconText)
    local btn = Instance.new("TextButton")
    btn.Name = tabName .. "Btn"
    btn.Size = UDim2.new(0.9, 0, 0, 36)
    btn.Position = UDim2.new(0.05, 0, 0, 8 + (#tabButtons * 42))
    btn.BackgroundColor3 = Color3.fromRGB(38, 38, 46)
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.TextSize = 13
    btn.Font = Enum.Font.SourceSansBold
    btn.Text = iconText .. " " .. tabName
    btn.Parent = sidebar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local frame = Instance.new("ScrollingFrame")
    frame.Name = tabName .. "Frame"
    frame.Size = UDim2.new(1, -5, 1, 0)
    frame.BackgroundTransparency = 1
    frame.ScrollBarThickness = 4
    frame.Visible = false
    frame.Parent = contentArea

    tabs[tabName] = frame
    table.insert(tabButtons, btn)

    btn.MouseButton1Click:Connect(function()
        for name, tFrame in pairs(tabs) do
            tFrame.Visible = (name == tabName)
        end
        for _, b in ipairs(tabButtons) do
            b.BackgroundColor3 = Color3.fromRGB(38, 38, 46)
            b.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        btn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)

    return frame
end

