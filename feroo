-- Directional Detection Modes: "Behind & Sides", "Behind Only", "Sides Only", "Front Only", "All 360°"
local detectionModes = {"Behind & Sides", "Behind Only", "Sides Only", "Front Only", "All 360°"}
local currentModeIndex = 1
local detectionAngleMode = detectionModes[currentModeIndex]

-- ----------------------------------------------------
-- 1. Directional Angle Math (Dot Product Filter)
-- ----------------------------------------------------
local function isPlayerInDetectionZone(myHrp, otherHrp)
    if detectionAngleMode == "All 360°" then return true end

    local relPos = (otherHrp.Position - myHrp.Position)
    local flatRelPos = Vector3.new(relPos.X, 0, relPos.Z)
    if flatRelPos.Magnitude == 0 then return true end
    local dirToOther = flatRelPos.Unit

    local lookVec = Vector3.new(myHrp.CFrame.LookVector.X, 0, myHrp.CFrame.LookVector.Z).Unit
    local rightVec = Vector3.new(myHrp.CFrame.RightVector.X, 0, myHrp.CFrame.RightVector.Z).Unit

    local forwardDot = lookVec:Dot(dirToOther) -- > 0 front, < 0 behind
    local rightDot = math.abs(rightVec:Dot(dirToOther)) -- close to 1 sides

    if detectionAngleMode == "Behind Only" then
        return forwardDot < -0.3 -- Karakterin Arkası
    elseif detectionAngleMode == "Sides Only" then
        return rightDot > 0.6 -- Karakterin Yanları (Sol / Sağ)
    elseif detectionAngleMode == "Behind & Sides" then
        return forwardDot < 0.3 -- Ön Taraf Hariç Her Yer (Arka + Yanlar)
    elseif detectionAngleMode == "Front Only" then
        return forwardDot > 0.4 -- Karakterin Önü
    end
    return true
end

