-- ----------------------------------------------------
-- 4. Yardımcı Fizik ve Raycast İşlevleri
-- ----------------------------------------------------
local function clearPhysics(character)
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

local function getSafePosition(startPos, targetPos, ignoreList)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = ignoreList
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true

    local direction = targetPos - startPos
    local rayResult = Workspace:Raycast(startPos, direction, raycastParams)

    if rayResult then
        return rayResult.Position - (direction.Unit * 1.5)
    end

    return targetPos
end

-- Akıllı Pozisyon Seçici (Kalabalık & Duvar Taraması)
local function getBestEvadePosition(oldPos, targetHrp, baseDist, ignoreList, currentTargetPlayer)
    local candidateAngles = {180, 135, -135, 90, -90, 45, -45}
    local bestPos = nil
    local lowestCrowdCount = 999

    for _, angle in ipairs(candidateAngles) do
        -- Açı dönüştürme
        local rad = math.rad(angle)
        local rotatedCFrame = targetHrp.CFrame * CFrame.Angles(0, rad, 0)
        local dir = rotatedCFrame.LookVector

        local rawTargetPos = Vector3.new(
            targetHrp.Position.X + (dir.X * baseDist),
            targetHrp.Position.Y,
            targetHrp.Position.Z + (dir.Z * baseDist)
        )

        local safePos = getSafePosition(oldPos, rawTargetPos, ignoreList)

        -- Bu noktanın 5 stud yakınındaki insan sayısını say
        local crowdCount = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer and p ~= currentTargetPlayer and p.Character then
                local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
                if pHrp and (pHrp.Position - safePos).Magnitude <= 5 then
                    crowdCount = crowdCount + 1
                end
            end
        end

        -- Eğer etrafta hiç kimse yoksa bu en mükemmel açıdır, direkt seç!
        if crowdCount == 0 then
            return safePos
        end

        -- Aksi halde en az kalabalık olan açıyı hafızaya al
        if crowdCount < lowestCrowdCount then
            lowestCrowdCount = crowdCount
            bestPos = safePos
        end
    end

    return bestPos or (targetHrp.Position - (targetHrp.CFrame.LookVector * baseDist))
end

-- ----------------------------------------------------
-- 5. 10 Stud Dash (İleri Işınlanma)
-- ----------------------------------------------------
dashBtn.MouseButton1Click:Connect(function()
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local startPos = hrp.Position
    local forwardDir = hrp.CFrame.LookVector
    local desiredTarget = startPos + (forwardDir * dashDistance)

    local safePos = getSafePosition(startPos, desiredTarget, {char})

    clearPhysics(char)
    hrp.CFrame = CFrame.new(safePos, safePos + forwardDir)
    clearPhysics(char)
end)

-- ----------------------------------------------------
-- 6. Ana Döngü (Akıllı Oto Kaçış)
-- ----------------------------------------------------
RunService.Heartbeat:Connect(function()
    if not enabled or cooldown then return end

    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            -- Takım Filtresi Kontrolü
            if teamFilter and player.Team ~= nil and player.Team == localPlayer.Team then
                continue
            end

            local otherHrp = player.Character:FindFirstChild("HumanoidRootPart")
            local otherHum = player.Character:FindFirstChildOfClass("Humanoid")

            -- Can ve Doğma Kalkanı (ForceField) Kontrolü
            if otherHrp and otherHum and otherHum.Health > 0 and not player.Character:FindFirstChildOfClass("ForceField") then
                local distance = (hrp.Position - otherHrp.Position).Magnitude

                if distance <= detectionDistance then
                    teleportCount = teleportCount + 1
                    
                    -- Her 15. ışınlanmayı atla (İnsan taklidi)
                    if teleportCount % 15 == 0 then
                        cooldown = true
                        task.wait(baseCooldown)
                        cooldown = false
                        break
                    end

                    cooldown = true

                    local oldPosition = hrp.Position

                    -- Randomization (Bot gibi görünmeme & Anti-cheat atlatma)
                    local randomDistOffset = math.random(-5, 5) / 10 -- ±0.5 stud rastgelelik
                    local actualTeleportDist = math.clamp(detectionDistance + randomDistOffset, 3, 15)
                    local randomCooldown = baseCooldown + (math.random(0, 20) / 1000) -- ~0.04s - 0.06s

                    local ignoreList = {char, player.Character}

                    -- Akıllı Yön & Kalabalık Taraması Yaparak En Uygun Noktayı Bul
                    local finalPosition = getBestEvadePosition(oldPosition, otherHrp, actualTeleportDist, ignoreList, player)

                    clearPhysics(char)

                    -- Bakış Yönü Kilitli Işınlanma
                    local lookTarget = Vector3.new(oldPosition.X, finalPosition.Y, oldPosition.Z)

                    if (finalPosition - lookTarget).Magnitude > 0.1 then
                        hrp.CFrame = CFrame.lookAt(finalPosition, lookTarget)
                    else
                        hrp.CFrame = CFrame.new(finalPosition)
                    end

                    clearPhysics(char)

                    task.wait(randomCooldown)
                    cooldown = false
                    break
                end
            end
        end
    end
end)
