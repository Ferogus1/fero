-- [MODÜL 5] Ghosting / Mute Modülü (Seçili Oyuncuyu Saydam Yap)
CreateActionButton("👻 Yakındaki Oyuncuları Saydamlaştır", Color3.fromRGB(90, 95, 110), function()
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
	
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= LocalPlayer and otherPlayer.Character then
			local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
			if otherRoot and (myChar.HumanoidRootPart.Position - otherRoot.Position).Magnitude <= 15 then
				for _, part in ipairs(otherPlayer.Character:GetDescendants()) do
					if part:IsA("BasePart") then
						part.LocalTransparencyModifier = 0.8
					end
				end
			end
		end
	end
end)

