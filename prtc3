-- [MODÜL 1] Anti-Toxic Chat Dönüştürücü (Client-Side Filter)
if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
	TextChatService.OnIncomingChatMessage = function(message)
		if not Config.AntiToxicChat then return end
		local text = message.Text:lower()
		
		for toxicWord, wholesomeWord in pairs(WholesomeReplacements) do
			if text:find("%f[%a]" .. toxicWord .. "%f[%A]") or text == toxicWord then
				local properties = Instance.new("TextChatMessageProperties")
				properties.Text = wholesomeWord
				return properties
			end
		end
	end
end

CreateToggleButton("Anti-Toxic Chat Dönüştürücü", Config.AntiToxicChat, function(newState)
	Config.AntiToxicChat = newState
end)

-- [MODÜL 2] Kişisel Alan Kalkanı (Anti-Bodyblock)
RunService.Heartbeat:Connect(function()
	if not Config.PersonalSpaceShield then return end
	
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local myPos = char.HumanoidRootPart.Position

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= LocalPlayer and otherPlayer.Character and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
			local otherChar = otherPlayer.Character
			local otherRoot = otherChar.HumanoidRootPart
			local dist = (myPos - otherRoot.Position).Magnitude

			if dist < Config.ShieldDistance then
				-- Yaklaşan oyuncunun çakışmasını (collision) geçici olarak kapat
				for _, part in ipairs(otherChar:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
			end
		end
	end
end)

CreateToggleButton("Kişisel Alan Kalkanı (Anti-Push)", Config.PersonalSpaceShield, function(newState)
	Config.PersonalSpaceShield = newState
end)

